// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Market {
  TW
  US
}

enum Side {
  BUY
  SELL
}

model Transaction {
  id        String   @id @default(cuid())
  tradeDate DateTime
  market    Market
  symbol    String
  side      Side
  quantity  Float
  price     Float
  fxRate    Float
  createdAt DateTime @default(now())

  @@index([symbol])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Append-only: application code only ever creates rows here, never
// updates or deletes them — this table is the permanent record of what
// happened to the Transaction table, so it can't itself be rewritten.
model TransactionAuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  transactionId String
  before        Json?
  after         Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
}
