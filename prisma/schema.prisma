// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Market {
  TW
  US
}

enum Side {
  BUY
  SELL
}

model Transaction {
  id        String   @id @default(cuid())
  tradeDate DateTime
  market    Market
  symbol    String
  side      Side
  quantity  Float
  price     Float
  fxRate    Float
  createdAt DateTime @default(now())

  @@index([symbol])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Append-only: application code only ever creates rows here, never
// updates or deletes them — this table is the permanent record of what
// happened to the Transaction table, so it can't itself be rewritten.
model TransactionAuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  transactionId String
  before        Json?
  after         Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
}

model Dividend {
  id          String   @id @default(cuid())
  market      Market
  symbol      String
  paymentDate DateTime
  amount      Float
  fxRate      Float
  createdAt   DateTime @default(now())

  @@index([symbol])
}

// Append-only, mirroring TransactionAuditLog — kept as its own table and
// history page rather than merged with the transaction audit log.
model DividendAuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  dividendId String
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}

// Singleton row (always id = 1) recording the last date the auto
// dividend-detection scan ran — needs to be durable across server
// restarts, unlike the in-memory symbol-name cache, since it gates a
// once-a-day write rather than just a read.
model DividendScanState {
  id          Int      @id @default(1)
  lastRunDate DateTime?
}
